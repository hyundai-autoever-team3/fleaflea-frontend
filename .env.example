# 개발: 비워 둘 것. 코드의 '/api/v1/...'을 그대로 요청하고
# 개발 서버(vite.config.ts)의 프록시가 백엔드로 넘긴다.
# 여기에 '/api'를 넣으면 '/api'가 두 번 붙어 리프레시 토큰 쿠키가 어긋난다
VITE_API_BASE_URL=

# 배포(Vercel 등): 프록시가 없으므로 전체 주소를 넣을 것.
# 이 값을 쓰려면 백엔드 CORS(SecurityConfig의 corsConfigurationSource)에
# 배포 도메인이 허용 목록으로 등록돼 있어야 함
# VITE_API_BASE_URL=https://fleaflea.duckdns.org
